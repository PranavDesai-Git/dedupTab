{
  "manifest_version": 3,
  "name": "dedupTab",
  "version": "0.1.0",
  "description": "Helps you not get lost in the tab sauce",
  "permissions": [
    "tabs",
    "notifications",
    "storage"
  ],
  "action": {
    "default_title": "dedupTab",
    "default_popup": "popup.html"
  },
  "commands": {
    "jump_back": {
      "suggested_key": {
        "default": "Alt+Z",
        "mac": "Alt+Z"
      },
      "description": "Jump back to previous tab"
    },
    "jump_forward": {
      "suggested_key": {
        "default": "Alt+X",
        "mac": "Alt+X"
      },
      "description": "Jump forward to next tab"
    },
    "jump_tree_first": {
      "suggested_key": {
        "default": "Alt+G",
        "mac": "Alt+G"
      },
      "description": "Jump to bottom of tree (first tab opened)"
    },
    "jump_tree_latest": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Alt+Shift+G"
      },
      "description": "Jump to top of tree (latest tab opened)"
    },
    "close_detour": {
      "suggested_key": {
        "default": "Alt+W",
        "mac": "Alt+W"
      },
      "description": "Close all tabs in this detour and return to parent"
    },
    "prev_child": {
      "suggested_key": {
        "default": "Alt+Shift+E",
        "mac": "Alt+Shift+E"
      },
      "description": "Go to previous sibling tab in detour"
    },
    "next_child": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Go to next sibling tab in detour"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
