{
  "manifest_version": 3,
  "name": "dedupTab",
  "version": "0.1.0",
  "description": "Helps you not get lost in the tab sauce",
  "permissions": [
    "tabs",
    "notifications",
    "storage"
  ],
  "action": {
    "default_title": "dedupTab"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
