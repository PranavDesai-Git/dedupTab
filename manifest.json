{
  "manifest_version": 3,
  "name": "dedupTab",
  "version": "0.1.0",
  "description": "Helps you not get lost in the tab sauce",
  "permissions": [
    "tabs",
    "notifications",
    "storage"
  ],
  "action": {
    "default_title": "dedupTab",
    "default_popup": "popup.html"
  },
  "commands": {
    "jump_back": {
      "suggested_key": {
        "default": "Alt+Z",
        "mac": "Alt+Z"
      },
      "description": "Jump back to previous tab"
    },
    "jump_forward": {
      "suggested_key": {
        "default": "Alt+X",
        "mac": "Alt+X"
      },
      "description": "Jump forward to next tab"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
